<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Retroreflect</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 <%= yield(:body_class) %>">
    <header class="border-b border-slate-200 bg-white">
      <div class="app-header-inner mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
        <%= link_to "Retroreflect", root_path, class: "app-header-brand text-lg font-semibold tracking-tight" %>
        <% if authenticated? %>
          <nav class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
            <%= nav_link "Home", root_path %>
            <%= nav_link "Teams", facilitator_teams_path %>
            <%= nav_link "Retrospectives", retrospectives_path %>
            <%= nav_link "Actions", participant_action_items_path %>
            <% if current_user.system_admin? %>
              <%= nav_link "System Administration", system_admin_root_path %>
            <% end %>
            <span class="text-slate-500"><%= current_user.display_name %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: "text-slate-600 hover:text-slate-900" %>
          </nav>
        <% else %>
          <nav class="flex items-center gap-4 text-sm">
            <%= link_to "Sign in", new_session_path, class: "text-slate-600 hover:text-slate-900" %>
            <%= link_to "Register", new_registration_path, class: "rounded bg-teal-700 px-3 py-1.5 text-white hover:bg-teal-800" %>
          </nav>
        <% end %>
      </div>
    </header>

    <% if content_for?(:full_bleed) %>
      <% if flash.any? && !content_for?(:embedded_flash) %>
        <div class="home-flash-bar">
          <div class="mx-auto max-w-7xl px-5 py-3 sm:px-8 lg:px-10">
            <% flash.each do |type, message| %>
              <p class="rounded border px-4 py-3 text-sm <%= flash_class(type) %>"><%= message %></p>
            <% end %>
          </div>
        </div>
      <% end %>
      <main>
        <%= yield %>
      </main>
    <% else %>
      <main class="mx-auto max-w-6xl px-4 py-8">
        <% flash.each do |type, message| %>
          <p class="mb-6 rounded border px-4 py-3 text-sm <%= flash_class(type) %>"><%= message %></p>
        <% end %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
