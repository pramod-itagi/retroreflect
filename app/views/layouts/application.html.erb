<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Retroreflect</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 <%= yield(:body_class) %>">
    <%= render "shared/navbar" %>

    <div class="app-alerts home-flash-bar" aria-live="polite">
      <%= render_app_alerts %>
    </div>
    <%= render "shared/confirm_modal" %>

    <% if content_for?(:full_bleed) %>
      <main>
        <%= yield %>
      </main>
    <% else %>
      <main class="mx-auto max-w-6xl px-4 py-8">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
