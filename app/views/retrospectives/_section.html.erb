<%# locals: title, eyebrow, description, empty_title, empty_text, retrospectives, facilitated_team_ids, variant %>
<section class="retros-section retros-section-<%= variant %>">
  <p class="retros-section-kicker"><%= eyebrow %></p>
  <h2 class="display-face retros-section-title">
    <%= render "retrospectives/section_icon", variant: variant %>
    <span><%= title %></span>
  </h2>
  <p class="retros-section-lede"><%= description %></p>
  <% if retrospectives.any? %>
    <p class="retros-section-count"><%= pluralize(retrospectives.size, "session") %></p>
    <ul class="retros-section-list">
      <% retrospectives.each do |retrospective| %>
        <%= render "retrospectives/row",
                   retrospective: retrospective,
                   facilitated: facilitated_team_ids.include?(retrospective.team_id),
                   variant: variant %>
      <% end %>
    </ul>
  <% else %>
    <div class="retros-empty-card">
      <p class="retros-empty-title"><%= empty_title %></p>
      <p class="retros-empty-text"><%= empty_text %></p>
    </div>
  <% end %>
</section>
