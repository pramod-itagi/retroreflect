<% content_for :full_bleed, true %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<% end %>

<% show_active = retrospective_section_visible?(:active) %>
<% show_drafts = retrospective_section_visible?(:draft) %>
<% show_previous = retrospective_section_visible?(:previous) %>

<div class="workspace-page workspace-shell listing-page retros-page">
  <div class="listing-inner">
    <header class="listing-intro">
      <p class="listing-kicker">Your retrospectives</p>
      <h1 class="display-face listing-heading">Retrospectives</h1>
      <p class="listing-lede">Find your active sessions, unfinished drafts, and previous retrospectives.</p>
    </header>

    <%= form_with url: retrospectives_path, method: :get, class: "retros-filters" do %>
      <div class="retros-filters-grid">
        <div class="retros-filter-field">
          <%= label_tag :team_id, "Team" %>
          <%= select_tag :team_id,
                         options_from_collection_for_select(@filter_teams, :id, :name_for_select, params[:team_id]),
                         include_blank: "All teams",
                         class: "workspace-filter-field" %>
        </div>
        <div class="retros-filter-field">
          <%= label_tag :status, "Status" %>
          <%= select_tag :status,
                         options_for_select(
                           [["All statuses", ""], ["Active", "active"], ["Draft", "draft"], ["Previous", "previous"]],
                           params[:status]
                         ),
                         class: "workspace-filter-field" %>
        </div>
        <div class="retros-filter-field retros-filter-search">
          <%= label_tag :q, "Search" %>
          <%= text_field_tag :q, params[:q], placeholder: "Search retrospectives...", class: "workspace-filter-field" %>
        </div>
        <div class="retros-filter-submit">
          <%= button_tag "Filter", type: :submit, name: nil, class: "#{home_primary_button_classes} cursor-pointer border-0" %>
        </div>
      </div>
    <% end %>

    <% if retrospective_listing_generic_empty? %>
      <div class="retros-filtered-empty">
        <div class="retros-empty-card">
          <p class="retros-empty-title">No retrospectives found</p>
          <p class="retros-empty-text">Try changing your filters or search term.</p>
        </div>
      </div>
    <% else %>
      <div class="listing-sections">
        <% if show_active %>
          <%= render "retrospectives/section",
                     title: "Active",
                     eyebrow: "Current work",
                     description: "In progress with your team.",
                     empty_title: "No active retrospectives",
                     empty_text: "Your current retrospective sessions will appear here.",
                     retrospectives: @active,
                     facilitated_team_ids: @facilitated_team_ids,
                     variant: :active %>
        <% end %>

        <% if show_drafts %>
          <%= render "retrospectives/section",
                     title: "Drafts",
                     eyebrow: "Unfinished",
                     description: "Captured ideas waiting for a moment to begin.",
                     empty_title: "No drafts yet",
                     empty_text: "Retrospectives you've started but haven't launched will appear here.",
                     retrospectives: @drafts,
                     facilitated_team_ids: @facilitated_team_ids,
                     variant: :draft %>
        <% end %>

        <% if show_previous %>
          <%= render "retrospectives/section",
                     title: "Previous",
                     eyebrow: "History",
                     description: "A record of the conversations that moved the work forward.",
                     empty_title: "No previous retrospectives yet",
                     empty_text: "Completed retrospectives will appear here.",
                     retrospectives: @previous,
                     facilitated_team_ids: @facilitated_team_ids,
                     variant: :previous %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
