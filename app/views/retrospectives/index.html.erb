<% content_for :full_bleed, true %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<% end %>

<% none_found = @active.empty? && @drafts.empty? && @previous.empty? %>

<div class="workspace-page workspace-shell">
  <div class="workspace-container workspace-container-tight">
    <p class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-ink">
      <span class="inline-block h-2 w-2 rounded-full bg-coral" aria-hidden="true"></span>
      Your retrospectives
    </p>
    <h1 class="display-face text-4xl font-bold leading-[0.98] tracking-[-0.045em] text-ink sm:text-5xl">Retrospectives</h1>
    <p class="mt-3 max-w-xl text-lg leading-7 text-[#39514a]">Find your active sessions, unfinished drafts, and previous retrospectives.</p>

    <%= form_with url: retrospectives_path, method: :get, class: "home-card mt-6 px-5 py-4 sm:px-6" do %>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-[minmax(10rem,13rem)_minmax(10rem,13rem)_minmax(0,1fr)_auto] lg:items-end">
        <div class="flex min-w-0 flex-col gap-1.5">
          <%= label_tag :team_id, "Team", class: "text-xs font-semibold uppercase tracking-[0.12em] text-[#466057]" %>
          <%= select_tag :team_id,
                         options_from_collection_for_select(@filter_teams, :id, :name_for_select, params[:team_id]),
                         include_blank: "All teams",
                         class: "workspace-filter-field" %>
        </div>
        <div class="flex min-w-0 flex-col gap-1.5">
          <%= label_tag :status, "Status", class: "text-xs font-semibold uppercase tracking-[0.12em] text-[#466057]" %>
          <%= select_tag :status,
                         options_for_select(
                           [["All statuses", ""], ["Active", "active"], ["Draft", "draft"], ["Previous", "previous"]],
                           params[:status]
                         ),
                         class: "workspace-filter-field" %>
        </div>
        <div class="flex min-w-0 flex-col gap-1.5 sm:col-span-2 lg:col-span-1">
          <%= label_tag :q, "Search", class: "text-xs font-semibold uppercase tracking-[0.12em] text-[#466057]" %>
          <%= text_field_tag :q, params[:q], placeholder: "Search retrospectives...", class: "workspace-filter-field" %>
        </div>
        <div class="sm:col-span-2 lg:col-span-1">
          <%= button_tag "Filter", type: :submit, name: nil, class: "#{home_primary_button_classes} w-full cursor-pointer border-0 lg:w-auto" %>
        </div>
      </div>
    <% end %>
  </div>

  <% if none_found && retrospective_listing_filters_applied? %>
    <div class="mx-auto max-w-7xl px-5 pb-10 sm:px-8 lg:px-10">
      <div class="home-card px-6 py-5">
        <p class="font-semibold text-ink">No retrospectives found</p>
        <p class="mt-2 leading-6 text-[#466057]">Try changing your filters or search term.</p>
      </div>
    </div>
  <% else %>
    <%= render "retrospectives/section",
               title: "Active",
               eyebrow: "Current work",
               empty_title: "No active retrospectives",
               empty_text: "Your current retrospective sessions will appear here.",
               retrospectives: @active,
               facilitated_team_ids: @facilitated_team_ids,
               variant: :active %>

    <div class="mx-auto max-w-7xl px-5 pb-10 sm:px-8 lg:px-10">
      <%= render "retrospectives/section",
                 title: "Drafts",
                 eyebrow: "Unfinished",
                 empty_title: "No drafts yet",
                 empty_text: "Retrospectives you've started but haven't launched will appear here.",
                 retrospectives: @drafts,
                 facilitated_team_ids: @facilitated_team_ids,
                 variant: :draft %>

      <%= render "retrospectives/section",
                 title: "Previous",
                 eyebrow: "History",
                 empty_title: "No previous retrospectives yet",
                 empty_text: "Completed retrospectives will appear here.",
                 retrospectives: @previous,
                 facilitated_team_ids: @facilitated_team_ids,
                 variant: :previous %>
    </div>
  <% end %>
</div>
