<% content_for :title, "Page not found" %>
<% content_for :full_bleed, true %>

<%= render layout: "errors/page", locals: {
      code: "404",
      heading: "We couldn't find that page.",
      lede: "The page you're looking for doesn't exist or may have been moved."
    } do %>
  <%= link_to "Back to home", root_path, class: home_primary_button_classes %>
  <button type="button" class="home-action home-action-secondary" onclick="history.back()">Go back</button>
<% end %>
