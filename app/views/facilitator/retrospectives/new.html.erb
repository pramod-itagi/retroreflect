<% content_for :full_bleed, true %>

<% base_errors = @retrospective.errors[:base] %>

<div class="workspace-page workspace-shell">
  <div class="workspace-container">
    <div class="max-w-2xl">
      <p class="mb-5">
        <%= back_nav_link facilitator_team_path(@team), @team.name %>
      </p>

      <p class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-ink">
        <span class="inline-block h-2 w-2 rounded-full bg-coral" aria-hidden="true"></span>
        <%= @team.name %>
      </p>
      <h1 class="display-face break-words text-4xl font-bold leading-[0.98] tracking-[-0.045em] text-ink sm:text-5xl">New retrospective</h1>
      <p class="mt-3 max-w-lg text-lg leading-7 text-muted">The sprint number and title are assigned automatically. Choose who will submit notes. You can adjust the roster until collection starts.</p>

      <%= form_with model: @retrospective,
                    url: facilitator_team_retrospectives_path(@team),
                    html: { novalidate: true },
                    class: "mt-6 space-y-6" do |form| %>
        <% if base_errors.any? %>
          <%= app_alert(kind: "error", messages: base_errors, autohide: false) %>
        <% end %>

        <div class="space-y-5">
          <div>
            <p class="mb-2 text-sm font-semibold text-ink">Sprint</p>
            <p class="workspace-readonly-value"><%= @sprint_identifier %></p>
          </div>

          <div>
            <p class="mb-2 text-sm font-semibold text-ink">Retrospective title</p>
            <p class="workspace-readonly-value"><%= @generated_title %></p>
          </div>
        </div>

        <fieldset class="home-card px-6 py-5">
          <legend class="sr-only">Participants</legend>
          <h2 class="text-base font-semibold text-ink">Participants</h2>
          <p class="mt-1 text-sm leading-6 text-muted">Team members only. Facilitators run the meeting and do not submit notes.</p>
          <% if @members.any? %>
            <div class="mt-4 divide-y divide-[var(--line)]">
              <% @members.each do |member| %>
                <label class="flex cursor-pointer items-start gap-3 rounded-sm px-3 py-3 -mx-3 text-sm leading-6 text-ink hover:bg-paper" for="participant_<%= member.id %>">
                  <%= check_box_tag "participant_ids[]",
                                    member.id,
                                    Array(params[:participant_ids]).map(&:to_s).include?(member.id.to_s),
                                    id: "participant_#{member.id}",
                                    class: "mt-1 h-4 w-4 shrink-0 rounded border-[var(--line)] text-coral focus:ring-coral" %>
                  <span class="min-w-0 break-words font-medium"><%= member.display_name %></span>
                </label>
              <% end %>
            </div>
          <% else %>
            <p class="mt-4 text-sm leading-6 text-muted">Add members to this team first, then come back to build the roster.</p>
          <% end %>
        </fieldset>

        <%= form.submit "Create retrospective", class: "#{home_primary_button_classes} w-full cursor-pointer sm:w-auto", data: { turbo_submits_with: "Creating..." } %>
      <% end %>
    </div>
  </div>
</div>
