<% content_for :full_bleed, true %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<% end %>

<% title_error = @retrospective.errors[:title].any? ? "Title can't be blank." : "" %>
<% sprint_error = @retrospective.errors[:sprint_label].any? ? "Please select a sprint number." : "" %>
<% base_errors = @retrospective.errors[:base] %>

<div class="workspace-page workspace-shell">
  <div class="workspace-container">
    <div class="max-w-2xl">
      <p class="mb-5">
        <%= link_to "Back to #{@team.name}", facilitator_team_path(@team), class: home_quiet_link_classes %>
      </p>

      <p class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-ink">
        <span class="inline-block h-2 w-2 rounded-full bg-coral" aria-hidden="true"></span>
        <%= @team.name %>
      </p>
      <h1 class="display-face break-words text-4xl font-bold leading-[0.98] tracking-[-0.045em] text-ink sm:text-5xl">New retrospective</h1>
      <p class="mt-3 max-w-lg text-lg leading-7 text-[#39514a]">Name the session, pick the sprint, then choose who will submit notes. You can adjust the roster until collection starts.</p>

      <%= form_with model: @retrospective,
                    url: facilitator_team_retrospectives_path(@team),
                    html: { novalidate: true },
                    class: "mt-6 space-y-6",
                    data: { controller: "retrospective-form", action: "submit->retrospective-form#submit" } do |form| %>
        <% if base_errors.any? %>
          <%= app_alert(kind: "error", messages: base_errors, autohide: false) %>
        <% end %>

        <div class="space-y-5">
          <div>
            <%= form.label :title, class: "mb-2 block text-sm font-semibold text-ink" %>
            <%= form.text_field :title,
                                required: true,
                                placeholder: "Sprint 12 retro",
                                aria: { describedby: "retrospective-title-error", invalid: title_error.present? },
                                class: "workspace-field",
                                data: { retrospective_form_target: "title" } %>
            <p id="retrospective-title-error"
               class="mt-2 min-h-5 text-sm leading-5 text-coral"
               aria-live="polite"
               data-retrospective-form-target="titleError"><%= title_error %></p>
          </div>

          <div>
            <%= form.label :sprint_label, "Sprint number", class: "mb-2 block text-sm font-semibold text-ink" %>
            <%= form.select :sprint_label,
                            Retrospective::SPRINT_LABELS.map { |label| [label, label] },
                            { include_blank: "Select sprint number" },
                            {
                              required: true,
                              class: "workspace-field",
                              aria: { describedby: "retrospective-sprint-error", invalid: sprint_error.present? },
                              data: { retrospective_form_target: "sprint" }
                            } %>
            <p id="retrospective-sprint-error"
               class="mt-2 min-h-5 text-sm leading-5 text-coral"
               aria-live="polite"
               data-retrospective-form-target="sprintError"><%= sprint_error %></p>
          </div>
        </div>

        <fieldset class="home-card px-6 py-5">
          <legend class="sr-only">Participants</legend>
          <h2 class="text-base font-semibold text-ink">Participants</h2>
          <p class="mt-1 text-sm leading-6 text-[#466057]">Team members only. Facilitators run the meeting and do not submit notes.</p>
          <% if @members.any? %>
            <div class="mt-4 divide-y divide-[var(--line)]">
              <% @members.each do |member| %>
                <label class="flex cursor-pointer items-start gap-3 rounded-sm px-3 py-3 -mx-3 text-sm leading-6 text-ink hover:bg-paper" for="participant_<%= member.id %>">
                  <%= check_box_tag "participant_ids[]",
                                    member.id,
                                    Array(params[:participant_ids]).map(&:to_s).include?(member.id.to_s),
                                    id: "participant_#{member.id}",
                                    class: "mt-1 h-4 w-4 shrink-0 rounded border-[var(--line)] text-coral focus:ring-coral" %>
                  <span class="min-w-0 break-words font-medium"><%= member.display_name %></span>
                </label>
              <% end %>
            </div>
          <% else %>
            <p class="mt-4 text-sm leading-6 text-[#466057]">Add members to this team first, then come back to build the roster.</p>
          <% end %>
        </fieldset>

        <%= form.submit "Create retrospective", class: "#{home_primary_button_classes} w-full cursor-pointer sm:w-auto" %>
      <% end %>
    </div>
  </div>
</div>
