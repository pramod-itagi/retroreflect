<% content_for :full_bleed, true %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<% end %>

<div class="workspace-page workspace-shell">
  <div class="workspace-container">
    <p class="mb-4 max-w-3xl">
      <%= link_to "Back to #{@retrospective.title}", facilitator_retrospective_path(@retrospective), class: "#{home_quiet_link_classes} break-words" %>
    </p>

    <p class="mb-5 rounded border border-[var(--line)] bg-[#dce9df] px-4 py-2.5 text-sm leading-6 text-ink">
      Notes revealed anonymously.
    </p>

    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div class="min-w-0">
        <% if @retrospective.sprint_label.present? %>
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-coral"><%= @retrospective.sprint_label %></p>
        <% end %>
        <h1 class="display-face mt-2 text-4xl font-bold leading-[0.98] tracking-[-0.045em] text-ink sm:text-5xl">Meeting</h1>
        <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm leading-6 text-[#466057]">
          <span>Notes are anonymous</span>
          <span aria-hidden="true">·</span>
          <span class="<%= retrospective_status_badge_classes(@retrospective.status) %>"><%= @retrospective.status.humanize %></span>
        </p>
      </div>
      <% if @retrospective.discussing? %>
        <%= button_to "Close retrospective",
                      close_facilitator_retrospective_path(@retrospective),
                      class: "home-action home-action-secondary w-full sm:w-auto",
                      form_class: "w-full shrink-0 sm:w-auto" %>
      <% end %>
    </div>

    <div class="mt-8 grid items-start gap-5 xl:grid-cols-[minmax(16rem,20rem)_minmax(0,1fr)]">
      <aside data-meeting-status class="home-card px-5 py-5">
        <h2 class="text-sm font-bold uppercase tracking-[0.16em] text-[#466057]">Submission status</h2>
        <p class="mt-2 text-lg font-semibold text-ink"><%= @submitted_count %> of <%= @participations.size %> submitted</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          <% @participations.sort_by { |participation| display_name_for(participation.user) }.each do |participation| %>
            <li class="flex items-center justify-between gap-3">
              <span class="min-w-0 break-words font-medium text-ink"><%= display_name_for(participation.user) %></span>
              <span class="<%= participation_status_badge_classes(participation.response_status_label) %> shrink-0">
                <%= participation.response_status_label %>
              </span>
            </li>
          <% end %>
        </ul>
        <p class="mt-4 text-xs leading-relaxed text-[#466057]">Names here are attendance only. They are not attached to notes on the board.</p>
      </aside>

      <div data-meeting-board data-controller="meeting-board" class="grid gap-4 md:grid-cols-2">
        <% Retrospective::CATEGORIES.each do |key, label| %>
          <% items = @items_by_category[key] || [] %>
          <section class="home-card flex flex-col px-5 py-5">
            <div class="mb-3 flex items-baseline justify-between gap-3">
              <h2 class="font-semibold leading-snug text-ink"><%= label %></h2>
              <span class="shrink-0 text-sm text-[#466057]"><%= items.size %></span>
            </div>
            <ul class="space-y-2.5">
              <% items.each do |item| %>
                <li data-meeting-board-target="card"
                    data-action="click->meeting-board#focus"
                    class="meeting-note cursor-pointer p-3 text-sm leading-relaxed">
                  <p class="whitespace-pre-wrap break-words text-ink"><%= item.body %></p>
                  <button type="button"
                          class="mt-2 text-xs font-semibold text-[#466057] hover:text-coral"
                          data-action="click->meeting-board#markDiscussed">
                    Mark discussed
                  </button>
                </li>
              <% end %>
            </ul>
            <% if items.empty? %>
              <p class="text-sm leading-6 text-[#466057]">No notes in this category.</p>
            <% end %>
          </section>
        <% end %>
      </div>
    </div>

    <% if @retrospective.discussing? %>
      <section class="mt-10">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-coral">Follow-through</p>
        <h2 class="display-face mt-2 text-2xl font-bold leading-tight tracking-[-0.035em] text-ink sm:text-3xl">Action items</h2>
        <p class="mt-2 max-w-xl text-base leading-6 text-[#466057]">Capture follow-ups during the meeting. Owners can update status later; only you can cancel.</p>
        <div class="mt-5">
          <%= render "facilitator/action_items/form", team: @team, retrospective: @retrospective, owners: @owners, branded: true %>
          <%= render "facilitator/action_items/list", action_items: @action_items, branded: true %>
        </div>
      </section>
    <% end %>
  </div>
</div>
