<h1 class="mb-6 text-2xl font-semibold">New team</h1>

<%= form_with model: @team, url: facilitator_teams_path, class: "max-w-md space-y-4" do |form| %>
  <% if @team.errors.any? %>
    <ul class="list-disc rounded border border-red-200 bg-red-50 px-5 py-3 text-sm text-red-800">
      <% @team.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
  <div>
    <%= form.label :name, class: "mb-1 block text-sm font-medium" %>
    <%= form.text_field :name, required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
  </div>
  <%= form.submit "Create team", class: "rounded bg-teal-700 px-4 py-2 text-white hover:bg-teal-800" %>
<% end %>
