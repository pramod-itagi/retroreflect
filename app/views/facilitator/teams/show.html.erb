<div class="mb-8">
  <p class="text-sm text-slate-500"><%= back_link facilitator_teams_path, "teams" %></p>
  <h1 class="text-2xl font-semibold"><%= @team.name %></h1>
</div>

<section class="mb-10">
  <h2 class="mb-3 text-lg font-medium">People</h2>
  <ul class="mb-4 divide-y divide-slate-200 rounded border border-slate-200 bg-white">
    <% @memberships.each do |membership| %>
      <li class="flex items-center justify-between px-4 py-3 text-sm">
        <span><%= display_name_for(membership.user) %> · <%= membership.role.humanize %></span>
        <%= link_to "Remove",
                    confirm_facilitator_team_membership_path(@team, membership),
                    class: "text-slate-500 hover:text-red-700" %>
      </li>
    <% end %>
  </ul>

  <% if @candidate_users.any? %>
    <%= form_with url: facilitator_team_memberships_path(@team), class: "flex flex-wrap items-start gap-3" do %>
      <div class="flex w-full min-w-40 flex-col gap-1 sm:w-auto">
        <%= label_tag :user_id, "Add person", class: "text-sm font-medium leading-5" %>
        <%= select_tag :user_id,
                       options_from_collection_for_select(@candidate_users, :id, :display_name),
                       prompt: "Select a confirmed user",
                       class: "h-10 w-full min-w-0 rounded border border-slate-300 py-2 pl-3 pr-10 text-sm sm:w-72" %>
      </div>
      <div class="flex w-full min-w-32 flex-col gap-1 sm:w-auto">
        <%= label_tag :role, "Role", class: "text-sm font-medium leading-5" %>
        <%= select_tag :role, options_for_select([["Member", "member"], ["Facilitator", "facilitator"]], "member"), class: "h-10 w-full rounded border border-slate-300 px-3 text-sm sm:w-auto" %>
      </div>
      <div class="flex w-full flex-col gap-1 sm:w-auto">
        <span class="hidden text-sm font-medium leading-5 sm:block sm:invisible" aria-hidden="true">Add</span>
        <%= submit_tag "Add", class: "h-10 w-full rounded bg-slate-900 px-3 text-sm text-white sm:w-auto" %>
      </div>
    <% end %>
  <% else %>
    <p class="text-sm text-slate-500">Everyone with a confirmed account is already on this team.</p>
  <% end %>
</section>

<section class="mb-10">
  <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-lg font-medium">Current retrospective</h2>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to "View retrospective history", retrospectives_path(team_id: @team.id), class: "text-sm text-teal-800 underline" %>
      <% unless @running_retrospective %>
        <%= link_to "New retrospective", new_facilitator_team_retrospective_path(@team), class: "rounded bg-teal-700 px-3 py-1.5 text-sm text-white hover:bg-teal-800" %>
      <% end %>
    </div>
  </div>
  <% if @running_retrospective %>
    <p class="mb-3 text-sm text-slate-600">
      This team already has an active retrospective.
      <%= link_to @running_retrospective.title, facilitator_retrospective_path(@running_retrospective), class: "text-teal-800 underline" %>
      must be closed before creating another.
    </p>
    <ul class="divide-y divide-slate-200 rounded border border-slate-200 bg-white">
      <li class="flex flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="min-w-0">
          <%= link_to @running_retrospective.title, facilitator_retrospective_path(@running_retrospective), class: "font-medium text-teal-800" %>
          <p class="text-sm text-slate-500">
            <%= @running_retrospective.status.humanize %>
            <% if @running_retrospective.sprint_label.present? %> · <%= @running_retrospective.sprint_label %><% end %>
            <% if @running_retrospective.collecting? %>
              · <%= submission_progress(@running_retrospective) %>
            <% elsif @running_retrospective.draft? && @running_retrospective.participant_count.zero? %>
              · Participants not configured
            <% end %>
          </p>
        </div>
        <%= retrospective_cta(@running_retrospective, facilitated: true) %>
      </li>
    </ul>
  <% else %>
    <p class="text-sm text-slate-500">No active retrospective.</p>
  <% end %>
</section>

<section class="mb-10">
  <h2 class="mb-3 text-lg font-medium">Current Action Items</h2>
  <% if @action_items.any? %>
    <ul class="mb-3 divide-y divide-slate-200 rounded border border-slate-200 bg-white">
      <% @action_items.each do |item| %>
        <li class="px-4 py-3">
          <p class="font-medium"><%= item.title %></p>
          <p class="text-sm text-slate-500">
            <%= display_name_for(item.owner) %>
            · <%= action_status_label(item.status) %>
            · Due <%= item.due_on.strftime("%b #{item.due_on.day}") %>
          </p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mb-3 text-sm text-slate-500">No current action items.</p>
  <% end %>
  <%= link_to "View all action items", participant_action_items_path, class: "text-sm text-teal-800 underline" %>
</section>

<section class="mt-10 border-t border-slate-200 pt-8">
  <h2 class="mb-2 text-lg font-medium">Archive Team</h2>
  <p class="mb-3 max-w-2xl text-sm text-slate-600">
    Archiving removes all current members from this team and prevents new retrospectives. Historical retrospectives and action items are retained.
  </p>
  <%= link_to "Archive Team", new_facilitator_team_archive_path(@team), class: "rounded border border-red-700 px-3 py-1.5 text-sm text-red-800 hover:bg-red-50" %>
</section>
