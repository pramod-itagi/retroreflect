<% content_for :full_bleed, true %>

<div class="workspace-page workspace-shell listing-page">
  <div class="listing-inner">
    <header class="listing-intro">
      <p class="listing-kicker">Your workspace</p>
      <h1 class="display-face listing-heading">Teams</h1>
      <p class="listing-lede"><%= teams_index_lede %></p>
    </header>

    <div class="listing-stack">
      <% if @teams.any? %>
        <ul class="grid gap-4">
          <% @teams.each do |team| %>
            <% role = @roles_by_team_id[team.id] %>
            <% retrospective = team.running_retrospective %>
            <li>
              <article class="home-card flex flex-col gap-4 px-6 py-5 sm:flex-row sm:items-center sm:justify-between">
                <div class="min-w-0">
                  <p class="display-face break-words text-2xl font-bold leading-tight text-ink"><%= team.name %></p>
                  <% if role == "member" %>
                    <p class="mt-2 text-sm leading-6 text-muted">Member · Active</p>
                  <% else %>
                    <p class="mt-2 text-sm leading-6 text-muted"><%= pluralize(team.member_count, "member") %></p>
                    <p class="mt-1 text-sm leading-6 text-muted">
                      <% if retrospective.present? %>
                        <%= retrospective.title %>
                        · <span class="<%= home_status_badge_classes(retrospective.status) %>"><%= retrospective.status.humanize %></span>
                      <% else %>
                        No active retrospective
                      <% end %>
                    </p>
                  <% end %>
                </div>
                <%= link_to role == "member" ? "View team" : "Open team",
                            workspace_team_path(team),
                            class: "#{home_primary_button_classes} shrink-0" %>
              </article>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="home-card px-6 py-5">
          <p class="font-semibold text-ink">No teams yet</p>
          <p class="mt-2 leading-6 text-muted"><%= teams_index_empty_copy %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>
