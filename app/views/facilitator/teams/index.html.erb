<div class="mb-6">
  <h1 class="text-2xl font-semibold">Teams</h1>
</div>

<% if @teams.any? %>
  <ul class="divide-y divide-slate-200 rounded border border-slate-200 bg-white">
    <% @teams.each do |team| %>
      <li class="px-4 py-3">
        <%= link_to team.name, facilitator_team_path(team), class: "font-medium text-teal-800" %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-sm text-slate-500">You are not facilitating any teams yet.</p>
<% end %>
