<%# locals: team, retrospective, owners %>
<% field_class = "workspace-field" %>
<% label_class = "mb-1.5 block text-xs font-semibold uppercase tracking-[0.12em] text-muted" %>

<%= form_with model: ActionItem.new,
              url: (retrospective ? facilitator_retrospective_action_items_path(retrospective) : facilitator_team_action_items_path(team)),
              class: "action-item-create home-card mb-5 px-6 py-6 sm:px-7 sm:py-7" do |form| %>
  <div class="grid gap-5 lg:grid-cols-[minmax(0,2fr)_minmax(13rem,1fr)_minmax(13rem,1fr)]">
    <div class="min-w-0">
      <%= form.label :title, class: label_class %>
      <%= form.text_field :title,
                          required: true,
                          class: field_class,
                          placeholder: "e.g. Improve deployment process" %>
    </div>
    <div class="min-w-0">
      <%= form.label :owner_id, "Owner", class: label_class %>
      <div class="action-item-control">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="action-item-field-icon" aria-hidden="true">
          <path d="M20 21a8 8 0 0 0-16 0"/>
          <circle cx="12" cy="8" r="3.25"/>
        </svg>
        <%= form.collection_select :owner_id,
                                  owners,
                                  :id,
                                  :display_name,
                                  { prompt: "Select owner" },
                                  { required: true, class: field_class } %>
      </div>
    </div>
    <div class="min-w-0">
      <%= form.label :due_on, "Due date", class: label_class %>
      <div class="action-item-control action-item-control--date" data-controller="date-picker">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="action-item-field-icon" aria-hidden="true">
          <rect x="4" y="5" width="16" height="15" rx="2"/>
          <path d="M8 3v4M16 3v4M4 10h16"/>
        </svg>
        <span class="action-item-date-display is-placeholder" data-date-picker-target="display" aria-hidden="true">Select date</span>
        <%= form.date_field :due_on,
                            required: true,
                            min: Time.zone.today,
                            class: "action-item-date-native",
                            data: {
                              date_picker_target: "input",
                              action: "click->date-picker#open input->date-picker#sync change->date-picker#sync"
                            } %>
      </div>
    </div>
  </div>

  <div class="mt-5">
    <%= form.label :description, class: label_class %>
    <%= form.text_area :description,
                       rows: 4,
                       class: field_class,
                       placeholder: "Add more details about this action item (optional)..." %>
  </div>

  <div class="mt-6">
    <%= form.submit "Add action item", class: "#{home_primary_button_classes} cursor-pointer", data: { turbo_submits_with: "Creating..." } %>
  </div>
<% end %>
