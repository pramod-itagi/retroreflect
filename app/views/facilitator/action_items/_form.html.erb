<%# locals: team, retrospective, owners, branded: false %>
<% branded = local_assigns.fetch(:branded, false) %>
<% field_class = branded ? "workspace-field" : "w-full rounded border border-slate-300 px-3 py-2" %>
<% label_class = branded ? "mb-1.5 block text-xs font-semibold uppercase tracking-[0.12em] text-[#466057]" : "mb-1 block text-sm font-medium" %>

<%= form_with model: ActionItem.new, url: (retrospective ? facilitator_retrospective_action_items_path(retrospective) : facilitator_team_action_items_path(team)), class: (branded ? "home-card mb-4 grid gap-4 px-5 py-5 md:grid-cols-4" : "mb-4 grid gap-3 rounded border border-slate-200 bg-white p-4 md:grid-cols-4") do |form| %>
  <div class="md:col-span-2">
    <%= form.label :title, class: label_class %>
    <%= form.text_field :title, required: true, class: field_class %>
  </div>
  <div>
    <%= form.label :owner_id, "Owner", class: label_class %>
    <%= form.collection_select :owner_id, owners, :id, :display_name, { prompt: "Select owner" }, { required: true, class: field_class } %>
  </div>
  <div>
    <%= form.label :due_on, "Due date", class: label_class %>
    <%= form.date_field :due_on, required: true, class: field_class %>
  </div>
  <div>
    <%= form.label :status, class: label_class %>
    <%= form.select :status, ActionItem::STATUSES.map { |status| [action_status_label(status), status] }, { selected: "open" }, class: field_class %>
  </div>
  <div class="md:col-span-4">
    <%= form.label :description, class: label_class %>
    <%= form.text_area :description, rows: 2, class: field_class %>
  </div>
  <div>
    <% if branded %>
      <%= form.submit "Add action item", class: "#{home_primary_button_classes} cursor-pointer" %>
    <% else %>
      <%= form.submit "Add action item", class: "rounded bg-slate-900 px-3 py-2 text-sm text-white" %>
    <% end %>
  </div>
<% end %>
