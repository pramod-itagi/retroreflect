<%# locals: action_items %>

<% if action_items.any? %>
  <ul class="home-card divide-y divide-[var(--line)] overflow-hidden">
    <% action_items.each do |item| %>
      <li class="px-5 py-4">
        <div class="flex flex-col gap-3 lg:flex-row lg:flex-wrap lg:items-start lg:justify-between">
          <div class="min-w-0 max-w-2xl">
            <p class="break-words font-semibold text-ink"><%= item.title %></p>
            <% if item.description.present? %>
              <p class="mt-1 whitespace-pre-wrap break-words text-sm leading-6 text-muted"><%= item.description %></p>
            <% end %>
            <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm leading-6 text-muted">
              <%= display_name_for(item.owner) %> ·
              <%= render "action_items/metadata", item: item %>
              <% if item.completed_at.present? %>
                <span aria-hidden="true">·</span>
                <span>Completed <%= action_item_calendar_date(item.completed_at) %></span>
              <% elsif item.cancelled_at.present? %>
                <span aria-hidden="true">·</span>
                <span>Cancelled <%= action_item_calendar_date(item.cancelled_at) %></span>
              <% end %>
            </p>
            <%= render "action_items/activity", item: item %>
          </div>
          <% unless item.terminal? %>
            <%= render "action_items/status_form",
                       item: item,
                       url: facilitator_action_item_path(item),
                       for_owner: false %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="home-card px-5 py-4">
    <p class="text-sm leading-6 text-muted">No action items yet.</p>
  </div>
<% end %>
