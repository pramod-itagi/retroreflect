<% if action_items.any? %>
  <ul class="divide-y divide-slate-200 rounded border border-slate-200 bg-white">
    <% action_items.each do |item| %>
      <li class="px-4 py-3">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0 max-w-2xl">
            <p class="font-medium"><%= item.title %></p>
            <% if item.description.present? %>
              <p class="mt-1 whitespace-pre-wrap text-sm text-slate-600"><%= item.description %></p>
            <% end %>
            <p class="mt-1 text-sm text-slate-500">
              <%= display_name_for(item.owner) %>
              · due <%= item.due_on %>
              · <%= action_status_label(item.status) %>
              <% if item.completed_at.present? %>
                · completed <%= item.completed_at.to_date %>
              <% elsif item.cancelled_at.present? %>
                · cancelled <%= item.cancelled_at.to_date %>
              <% end %>
            </p>
          </div>
          <% unless item.terminal? %>
            <%= form_with model: item, url: facilitator_action_item_path(item), method: :patch, class: "flex items-center gap-2" do |form| %>
              <%= form.select :status, item.available_statuses.map { |status| [action_status_label(status), status] }, {}, class: "rounded border border-slate-300 px-2 py-1 text-sm" %>
              <%= form.submit "Update", class: "text-sm text-teal-800 underline" %>
            <% end %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="rounded border border-dashed border-slate-300 bg-white px-4 py-6 text-sm text-slate-500">No action items yet.</p>
<% end %>
