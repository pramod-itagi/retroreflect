<% content_for :full_bleed, true %>

<div class="workspace-page workspace-shell listing-page">
  <div class="listing-inner">
    <header class="listing-intro">
      <p class="listing-back">
        <% if @can_show_team %>
          <%= back_nav_link facilitator_team_path(@team), @team.name %>
        <% else %>
          <%= back_nav_link retrospectives_path(team_id: @team.id), "retrospectives" %>
        <% end %>
      </p>
      <p class="listing-kicker"><%= @team.name_for_select %></p>
      <h1 class="display-face listing-heading">Action items</h1>
      <p class="listing-lede">All action items for this team, including completed and cancelled work.</p>
    </header>

    <div class="listing-stack">
      <% if @action_items.any? %>
        <ul class="grid gap-4">
          <% @action_items.each do |item| %>
            <li>
              <article id="action-item-<%= item.id %>" class="home-card px-6 py-5">
                <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                  <div class="min-w-0">
                    <p class="break-words text-lg font-semibold leading-snug text-ink"><%= item.title %></p>
                    <% if item.description.present? %>
                      <p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-muted"><%= item.description %></p>
                    <% end %>
                    <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm leading-6 text-muted">
                      <span><%= display_name_for(item.owner) %></span>
                      <span aria-hidden="true">·</span>
                      <%= render "action_items/metadata", item: item %>
                      <% if item.completed_at.present? %>
                        <span aria-hidden="true">·</span>
                        <span>Completed <%= action_item_calendar_date(item.completed_at) %></span>
                      <% elsif item.cancelled_at.present? %>
                        <span aria-hidden="true">·</span>
                        <span>Cancelled <%= action_item_calendar_date(item.cancelled_at) %></span>
                      <% end %>
                    </p>
                    <%= render "action_items/activity", item: item %>
                  </div>
                  <%= action_item_management_form(item) %>
                </div>
              </article>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="home-card px-6 py-5">
          <p class="font-semibold text-ink">No action items</p>
          <p class="mt-2 leading-6 text-muted">Action items created during this team's retrospectives will appear here.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
