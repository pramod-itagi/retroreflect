<% content_for :full_bleed, true %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<% end %>

<div class="workspace-page workspace-shell">
  <div class="workspace-container workspace-container-tight">
    <div class="max-w-2xl">
      <p class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-ink">
        <span class="inline-block h-2 w-2 rounded-full bg-coral" aria-hidden="true"></span>
        Team
      </p>
      <h1 class="display-face break-words text-4xl font-bold leading-[0.98] tracking-[-0.045em] text-ink">Remove <%= display_name_for(@membership.user) %> from <%= @team.name %>?</h1>
      <p class="mt-3 max-w-xl text-base leading-7 text-[#39514a]">
        <%= display_name_for(@membership.user) %> will no longer be a member of this team.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <%= link_to "Cancel", facilitator_team_path(@team), class: "home-action home-action-secondary" %>
        <%= button_to "Remove",
                      facilitator_team_membership_path(@team, @membership),
                      method: :delete,
                      class: "home-action home-action-danger-solid cursor-pointer",
                      form_class: "inline",
                      data: { turbo_submits_with: "Removing..." } %>
      </div>
    </div>
  </div>
</div>
