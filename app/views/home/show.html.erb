<% content_for :body_class, "home-layout" %>
<% content_for :full_bleed, true %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<% end %>

<div class="home-page">
  <section class="home-hero">
    <div class="home-hero-frame">
      <div class="home-hero-copy">
        <div class="home-hero-copy-inner">
          <p class="home-hero-kicker">
            <span class="inline-block h-2 w-2 rounded-full bg-coral" aria-hidden="true"></span>
            The space between sprints
          </p>
          <h1 class="display-face home-hero-heading">Make room for what your team is learning.</h1>
          <p class="home-hero-lede">
            Retroreflect helps teams pause, notice what went well and what to improve, decide what to continue, and turn that reflection into follow-through.
          </p>
          <div class="home-hero-note">
            <div class="home-hero-note-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.6 4.3L18 9l-4.4 1.7L12 15l-1.6-4.3L6 9l4.4-1.7L12 3z"/><path d="M19 14l.8 2.1L22 17l-2.2.9L19 20l-.8-2.1L16 17l2.2-.9L19 14z"/></svg>
            </div>
            <p>Designed for the honest conversations that make teams stronger—not just another status meeting.</p>
          </div>
        </div>
      </div>
      <div class="home-hero-panel">
        <%= image_tag "home/team-hands.jpg",
                      alt: "Team members placing their hands together around a table",
                      class: "home-hero-image" %>
        <aside class="home-reflection-card" aria-label="Retrospective prompts">
          <p class="home-reflection-kicker">The prompt</p>
          <p class="display-face home-reflection-heading">How should we move forward?</p>
          <div class="home-reflection-footer">
            <span class="home-reflection-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/></svg>
            </span>
            <p>What went well. What didn't. What to continue. What to improve.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <% running_work = home_running_work %>
  <% idle_facilitated_teams = home_idle_facilitated_teams %>

  <div class="listing-inner home-body">
    <section class="home-section">
      <p class="home-section-kicker">Right now</p>
      <h2 class="display-face home-section-title">Current retrospective</h2>
      <p class="home-section-lede">What you can work on now.</p>

      <% if running_work.any? %>
        <ul class="home-section-list">
          <% running_work.each do |item| %>
            <li>
              <%= render "home/current_retrospective",
                         team: item[:team],
                         retrospective: item[:retrospective],
                         facilitated: item[:facilitated] %>
            </li>
          <% end %>
        </ul>
        <% if idle_facilitated_teams.any? %>
          <ul class="home-section-list">
            <% idle_facilitated_teams.each do |team| %>
              <%= render "home/idle_facilitated_team", team: team %>
            <% end %>
          </ul>
        <% end %>
      <% elsif idle_facilitated_teams.any? %>
        <ul class="home-section-list">
          <% idle_facilitated_teams.each do |team| %>
            <%= render "home/idle_facilitated_team", team: team %>
          <% end %>
        </ul>
      <% else %>
        <div class="home-card home-section-card px-6 py-5">
          <p class="font-semibold text-ink">No active retrospective right now.</p>
          <p class="mt-2 leading-6 text-[#466057]">When a team starts collecting or discussing, it will appear here.</p>
        </div>
      <% end %>
    </section>

    <section class="home-section">
      <h2 class="display-face home-section-title">Your teams</h2>
      <p class="home-section-lede">A concise view of the teams you belong to.</p>
      <% if @teams.any? %>
        <ul class="home-section-list">
          <% @teams.each do |team| %>
            <li>
              <article class="home-card flex items-baseline justify-between gap-4 px-6 py-4">
                <div class="min-w-0">
                  <% if home_facilitator_of?(team) %>
                    <%= home_team_nav_link(team) %>
                  <% else %>
                    <p class="truncate font-semibold text-ink"><%= team.name %></p>
                  <% end %>
                </div>
                <p class="shrink-0 text-sm text-[#466057]"><%= pluralize(team.member_count, "member") %></p>
              </article>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="home-card home-section-card px-6 py-5">
          <p class="font-semibold text-ink">You are not on any teams yet.</p>
        </div>
      <% end %>
    </section>

    <section class="home-section">
      <div class="home-section-heading-row">
        <h2 class="display-face home-section-title">Action items needing attention</h2>
        <% if @attention_action_items.any? %>
          <%= link_to "View all", participant_action_items_path, class: home_quiet_link_classes %>
        <% end %>
      </div>
      <p class="home-section-lede">Open action items assigned to you.</p>
      <% if @attention_action_items.any? %>
        <ul class="home-section-list">
          <% @attention_action_items.each do |item| %>
            <li>
              <article class="home-card px-6 py-4">
                <p class="break-words font-semibold text-ink"><%= item.title %></p>
                <p class="mt-2 text-sm leading-6 text-[#466057]">
                  <%= item.team.name %>
                  · <%= action_status_label(item.status) %>
                  · due <%= item.due_on %>
                  <% if item.due_on < Date.current %> · overdue<% end %>
                </p>
              </article>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="home-card home-section-card px-6 py-5">
          <p class="font-semibold text-ink">No action items need attention.</p>
        </div>
      <% end %>
    </section>
  </div>
</div>
