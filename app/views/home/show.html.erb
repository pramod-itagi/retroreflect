<h1 class="mb-2 text-2xl font-semibold">Home</h1>
<p class="mb-8 text-slate-600">Current teams, retrospectives that need attention, and action items.</p>

<section class="mb-10">
  <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-lg font-medium">Active teams</h2>
    <% if can_create_team? %>
      <%= link_to "New team", new_facilitator_team_path, class: "rounded bg-teal-700 px-3 py-1.5 text-sm text-white hover:bg-teal-800" %>
    <% end %>
  </div>
  <% if @teams.any? %>
    <ul class="divide-y divide-slate-200 rounded border border-slate-200 bg-white">
      <% @teams.each do |team| %>
        <% facilitated = @facilitated_team_ids.include?(team.id) %>
        <% running = team.running_retrospective %>
        <li class="flex flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="min-w-0">
            <% if facilitated %>
              <%= link_to team.name, facilitator_team_path(team), class: "font-medium text-teal-800" %>
            <% else %>
              <p class="font-medium text-slate-900"><%= team.name %></p>
            <% end %>
            <p class="text-sm text-slate-500">
              <%= pluralize(team.member_count, "member") %>
              <% if running %>
                · <%= running.title %> — <%= running.status.humanize %>
                <% if running.collecting? %>
                  · <%= submission_progress(running) %>
                <% elsif running.draft? && running.participant_count.zero? %>
                  · Participants not configured
                <% end %>
              <% else %>
                · No active retrospective
              <% end %>
            </p>
          </div>
          <div class="shrink-0">
            <% if running %>
              <%= retrospective_cta(running, facilitated: facilitated) %>
            <% elsif facilitated %>
              <%= link_to "Start Retrospective", new_facilitator_team_retrospective_path(team), class: "rounded bg-teal-700 px-3 py-1.5 text-sm text-white hover:bg-teal-800" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-slate-500">You are not on any teams yet.</p>
  <% end %>
</section>

<% if @draft_retrospectives.any? %>
  <section class="mb-10">
    <h2 class="mb-3 text-lg font-medium">Draft retrospectives</h2>
    <ul class="divide-y divide-slate-200 rounded border border-slate-200 bg-white">
      <% @draft_retrospectives.each do |retrospective| %>
        <%= render "retrospectives/row", retrospective: retrospective, facilitated: true %>
      <% end %>
    </ul>
  </section>
<% end %>

<section>
  <div class="mb-3 flex items-center justify-between">
    <h2 class="text-lg font-medium">Action items needing attention</h2>
    <%= link_to "View all", participant_action_items_path, class: "text-sm text-teal-800 underline" %>
  </div>
  <% if @attention_action_items.any? %>
    <ul class="divide-y divide-slate-200 rounded border border-slate-200 bg-white">
      <% @attention_action_items.each do |item| %>
        <li class="px-4 py-3">
          <p class="font-medium"><%= item.title %></p>
          <p class="text-sm text-slate-500">
            <%= item.team.name %>
            · <%= action_status_label(item.status) %>
            · due <%= item.due_on %>
            <% if item.due_on < Date.current %> · overdue<% end %>
          </p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-slate-500">No action items need attention.</p>
  <% end %>
</section>
