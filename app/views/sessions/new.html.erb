<% content_for :full_bleed, true %>

<div class="login-page auth-screen workspace-shell">
  <section class="auth-split">
    <div class="auth-copy">
      <%= render "shared/auth_copy",
                 heading: "Sign in",
                 lede: "Continue to your team's reflections." %>
    </div>

    <div class="auth-panel">
      <div class="login-form-card">
        <%= form_with url: session_path, class: "auth-form" do %>
          <div>
            <%= label_tag :email, "Email", class: "auth-field-label" %>
            <div class="action-item-control action-item-control--text">
              <%= render "shared/auth_field_icon", name: "person" %>
              <%= email_field_tag :email, params[:email], required: true, autocomplete: "username", placeholder: "you@example.com", class: "workspace-field" %>
            </div>
          </div>
          <div>
            <%= label_tag :password, "Password", class: "auth-field-label" %>
            <div class="action-item-control action-item-control--text">
              <%= render "shared/auth_field_icon", name: "lock" %>
              <%= password_field_tag :password, nil, required: true, autocomplete: "current-password", placeholder: "Enter your password", class: "workspace-field" %>
            </div>
          </div>
          <%= submit_tag "Sign in", class: "home-action home-action-primary" %>
        <% end %>

        <p class="auth-or"><span>or</span></p>
        <p class="auth-alt-links">
          <%= link_to "Create an account", new_registration_path, class: "home-quiet-link" %>
          <span class="auth-alt-rule" aria-hidden="true"></span>
          <%= link_to "Forgot password?", new_password_reset_path, class: "home-quiet-link" %>
        </p>
      </div>
    </div>
  </section>
</div>
