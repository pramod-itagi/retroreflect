<% content_for :full_bleed, true %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<% end %>

<% submitted = @participation.submitted? %>
<% status_label = submitted ? "Submitted" : "Draft" %>
<% point_field_classes = "workspace-field min-h-[4.25rem] resize-y" %>

<div class="workspace-page workspace-shell">
  <div class="workspace-container workspace-container-tight">
    <p class="mb-2 flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-ink">
      <span class="inline-block h-2 w-2 rounded-full bg-coral" aria-hidden="true"></span>
      Session
    </p>
    <h1 class="display-face break-words text-3xl font-bold leading-[0.98] tracking-[-0.045em] text-ink sm:text-4xl"><%= @retrospective.title %></h1>
    <p class="session-meta mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm leading-6 text-[#466057]">
      <span><%= @retrospective.team.name %></span>
      <% if @retrospective.sprint_label.present? %>
        <span aria-hidden="true">·</span>
        <span><%= @retrospective.sprint_label %></span>
      <% end %>
      <span aria-hidden="true">·</span>
      <span class="<%= participation_status_badge_classes(status_label) %>"><%= status_label %></span>
    </p>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-[#466057]">
      Your feedback is anonymous. The facilitator can see whether you've submitted, but not who wrote each point.
      <% if submitted %>
        Your responses are locked until the meeting starts.
      <% end %>
    </p>

    <% if submitted %>
      <div class="mt-6 grid items-start gap-4 md:grid-cols-2">
        <% Retrospective::CATEGORIES.each do |key, label| %>
          <% category_drafts = @drafts.select { |draft| draft.category == key } %>
          <section class="home-card px-5 py-4">
            <h2 class="text-lg font-semibold text-ink"><%= label %></h2>
            <% if category_drafts.any? %>
              <ul class="mt-3 space-y-2">
                <% category_drafts.each do |draft| %>
                  <li class="rounded-sm bg-paper px-3 py-2.5">
                    <p class="whitespace-pre-wrap text-sm leading-6 text-ink"><%= draft.body %></p>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <p class="mt-3 text-sm leading-6 text-[#466057]">No points in this category.</p>
            <% end %>
          </section>
        <% end %>
      </div>
    <% else %>
      <div class="mt-6 grid items-start gap-4 md:grid-cols-2">
        <% Retrospective::CATEGORIES.each do |key, label| %>
          <% category_drafts = @drafts.select { |draft| draft.category == key } %>
          <section class="home-card px-5 py-4">
            <h2 class="text-lg font-semibold text-ink"><%= label %></h2>
            <% if category_drafts.any? %>
              <ul class="mt-3 space-y-2">
                <% category_drafts.each do |draft| %>
                  <li>
                    <%= text_area_tag "drafts[#{draft.id}][body]",
                                      draft.body,
                                      rows: 2,
                                      form: "save-drafts-form",
                                      class: point_field_classes %>
                    <div class="mt-1.5">
                      <%= link_to "Remove",
                                  participant_retrospective_draft_path(@retrospective, draft),
                                  data: { turbo_method: :delete, turbo_confirm: "Remove this point?", confirm_accept: "Remove", confirm_variant: "danger" },
                                  class: "text-sm font-semibold text-[#466057] hover:text-coral" %>
                    </div>
                  </li>
                <% end %>
              </ul>
            <% end %>
            <div class="mt-3" data-controller="add-points">
              <div data-add-points-target="list" class="space-y-2">
                <div data-add-points-item>
                  <%= text_area_tag "new_drafts[#{key}][]",
                                    nil,
                                    rows: 2,
                                    form: "save-drafts-form",
                                    placeholder: "Add a point…",
                                    class: point_field_classes %>
                </div>
              </div>
              <button type="button"
                      class="home-quiet-link mt-2"
                      data-action="add-points#add">
                Add another point
              </button>
              <template data-add-points-target="template">
                <div class="space-y-1.5" data-add-points-item>
                  <textarea name="new_drafts[<%= key %>][]"
                            rows="2"
                            form="save-drafts-form"
                            placeholder="Add a point…"
                            class="<%= point_field_classes %>"></textarea>
                  <div>
                    <button type="button" class="text-sm font-semibold text-[#466057] hover:text-coral" data-action="add-points#remove">Remove</button>
                  </div>
                </div>
              </template>
            </div>
          </section>
        <% end %>
      </div>

      <div class="mt-5 flex flex-col-reverse gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <%= form_with url: save_participant_retrospective_drafts_path(@retrospective),
                      method: :post,
                      html: { id: "save-drafts-form" },
                      class: "w-full sm:w-auto" do %>
          <%= submit_tag "Save Draft", class: "home-action home-action-secondary w-full cursor-pointer sm:w-auto" %>
        <% end %>
        <%= button_to "Submit Feedback",
                      participant_retrospective_submission_path(@retrospective),
                      class: "#{home_primary_button_classes} w-full cursor-pointer sm:w-auto",
                      form_class: "w-full sm:w-auto",
                      data: { disable_with: "Submitting…", turbo_submits_with: "Submitting…" },
                      form: {
                        data: {
                          turbo_confirm: "Submit your feedback?",
                          confirm_description: "Once submitted, you won't be able to edit your feedback.",
                          confirm_accept: "Submit Feedback",
                          confirm_busy: "Submitting…"
                        }
                      } %>
      </div>
    <% end %>
  </div>
</div>
