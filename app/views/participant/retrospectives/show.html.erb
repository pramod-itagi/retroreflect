<p class="mb-2 text-sm text-slate-500"><%= back_link root_path, "home" %></p>
<% if @retrospective.sprint_label.present? %>
  <p class="mb-1 text-sm font-medium uppercase tracking-wide text-teal-800"><%= @retrospective.sprint_label %></p>
<% end %>
<h1 class="mb-1 text-2xl font-semibold"><%= @retrospective.title %></h1>
<p class="mb-2 text-sm text-slate-500"><%= @retrospective.team.name %></p>
<p class="mb-2 text-sm font-medium <%= @participation.submitted? ? "text-teal-800" : "text-slate-600" %>">
  <%= @participation.submitted? ? "Submitted" : "Draft" %>
</p>
<p class="mb-8 max-w-2xl text-sm text-slate-600">
  These notes are only visible to you. The facilitator sees whether you have submitted, not what you wrote.
  <% if @participation.submitted? %>
    Your responses are locked until the meeting starts.
  <% else %>
    Save as many points as you want, then submit when you are done.
  <% end %>
</p>

<div class="max-w-3xl space-y-6">
  <% Retrospective::CATEGORIES.each do |key, label| %>
    <% category_drafts = @drafts.select { |draft| draft.category == key } %>
    <section class="rounded border border-slate-200 bg-white p-5">
      <h2 class="mb-4 text-lg font-medium"><%= label %></h2>
      <ul class="mb-4 space-y-3">
        <% category_drafts.each do |draft| %>
          <li class="rounded border border-slate-100 bg-slate-50 p-3">
            <% if @participation.submitted? %>
              <p class="whitespace-pre-wrap text-sm text-slate-800"><%= draft.body %></p>
            <% else %>
              <%= form_with model: draft, url: participant_retrospective_draft_path(@retrospective, draft), method: :patch, class: "space-y-2" do |form| %>
                <%= form.hidden_field :category %>
                <%= form.text_area :body, rows: 3, class: "w-full rounded border border-slate-300 px-2 py-1 text-sm" %>
                <div class="flex gap-3 text-sm">
                  <%= form.submit "Save", class: "text-teal-800 underline" %>
                  <%= link_to "Remove", participant_retrospective_draft_path(@retrospective, draft), data: { turbo_method: :delete, turbo_confirm: "Remove this point?" }, class: "text-slate-500" %>
                </div>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <% unless @participation.submitted? %>
        <%= form_with model: FeedbackDraft.new, url: participant_retrospective_drafts_path(@retrospective), class: "space-y-2" do |form| %>
          <%= form.hidden_field :category, value: key %>
          <%= form.text_area :body, rows: 3, placeholder: "Add a point…", class: "w-full rounded border border-slate-300 px-2 py-1 text-sm" %>
          <%= form.submit "Save draft", class: "rounded bg-teal-700 px-3 py-1.5 text-sm text-white" %>
        <% end %>
      <% end %>
    </section>
  <% end %>
</div>

<% unless @participation.submitted? %>
  <div class="mt-8 max-w-3xl rounded border border-slate-200 bg-white px-5 py-4">
    <p class="mb-3 text-sm text-slate-600">Submit when you are finished. You will not be able to edit after that.</p>
    <%= button_to "Submit responses", participant_retrospective_submission_path(@retrospective), class: "rounded bg-slate-900 px-4 py-2 text-sm text-white", form: { data: { turbo_confirm: "Submit your responses? You will not be able to edit them after this." } } %>
  </div>
<% end %>
