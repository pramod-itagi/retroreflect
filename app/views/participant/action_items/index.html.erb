<% content_for :full_bleed, true %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<% end %>

<div class="workspace-page workspace-shell">
  <div class="workspace-container">
    <p class="mb-4">
      <%= link_to "Back to home", root_path, class: home_quiet_link_classes %>
    </p>
    <p class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-ink">
      <span class="inline-block h-2 w-2 rounded-full bg-coral" aria-hidden="true"></span>
      Follow-through
    </p>
    <h1 class="display-face text-4xl font-bold leading-[0.98] tracking-[-0.045em] text-ink sm:text-5xl">Your action items</h1>
    <p class="mt-3 max-w-xl text-lg leading-7 text-[#39514a]">Keep track of the commitments assigned to you.</p>

    <% if @action_items.any? %>
      <ul class="mt-6 grid gap-4">
        <% @action_items.each do |item| %>
          <li>
            <article class="home-card px-6 py-5">
              <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                <div class="min-w-0">
                  <p class="break-words text-lg font-semibold leading-snug text-ink"><%= item.title %></p>
                  <% if item.description.present? %>
                    <p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-[#466057]"><%= item.description %></p>
                  <% end %>
                  <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm leading-6 text-[#466057]">
                    <span><%= item.team.name %></span>
                    <span aria-hidden="true">·</span>
                    <span>Due <%= item.due_on.strftime("%b %-d, %Y") %></span>
                    <span aria-hidden="true">·</span>
                    <span class="<%= action_item_badge_classes(item.status) %>"><%= action_status_label(item.status) %></span>
                    <% if action_item_overdue?(item) %>
                      <span aria-hidden="true">·</span>
                      <span class="inline-flex rounded-full bg-coral px-2.5 py-0.5 text-xs font-semibold text-white">Overdue</span>
                    <% end %>
                    <% if item.completed_at.present? %>
                      <span aria-hidden="true">·</span>
                      <span>completed <%= item.completed_at.to_date %></span>
                    <% elsif item.cancelled_at.present? %>
                      <span aria-hidden="true">·</span>
                      <span>cancelled <%= item.cancelled_at.to_date %></span>
                    <% end %>
                  </p>
                </div>
                <% if item.available_statuses(for_owner: true).any? %>
                  <%= form_with model: item, url: participant_action_item_path(item), method: :patch, class: "flex shrink-0 flex-wrap items-center gap-2" do |form| %>
                    <%= form.label :status, "Status", class: "sr-only" %>
                    <%= form.select :status, item.available_statuses(for_owner: true).map { |status| [action_status_label(status), status] }, {}, class: "workspace-select" %>
                    <%= form.submit "Update", class: "home-action home-action-secondary" %>
                  <% end %>
                <% end %>
              </div>
            </article>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="home-card mt-6 px-6 py-5">
        <p class="font-semibold text-ink">No action items</p>
        <p class="mt-2 leading-6 text-[#466057]">You're all caught up. New commitments assigned to you will appear here.</p>
      </div>
    <% end %>
  </div>
</div>
