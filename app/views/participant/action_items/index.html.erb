<% content_for :full_bleed, true %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<% end %>

<div class="workspace-page workspace-shell listing-page">
  <div class="listing-inner">
    <header class="listing-intro">
      <p class="listing-back">
        <%= back_nav_link root_path, "home" %>
      </p>
      <p class="listing-kicker">Follow-through</p>
      <h1 class="display-face listing-heading">Your action items</h1>
      <p class="listing-lede">Keep track of the commitments assigned to you.</p>
    </header>

    <div class="listing-stack">
      <% if @action_items.any? %>
        <ul class="grid gap-4">
          <% @action_items.each do |item| %>
            <li>
              <article class="home-card px-6 py-5">
                <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                  <div class="min-w-0">
                    <p class="break-words text-lg font-semibold leading-snug text-ink"><%= item.title %></p>
                    <% if item.description.present? %>
                      <p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-[#466057]"><%= item.description %></p>
                    <% end %>
                    <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm leading-6 text-[#466057]">
                      <span><%= item.team.name %></span>
                      <span aria-hidden="true">·</span>
                      <span>Due <%= item.due_on.strftime("%b %-d, %Y") %></span>
                      <span aria-hidden="true">·</span>
                      <span class="<%= action_item_badge_classes(item.status) %>"><%= action_status_label(item.status) %></span>
                      <% if action_item_overdue?(item) %>
                        <span aria-hidden="true">·</span>
                        <span class="inline-flex rounded-full bg-coral px-2.5 py-0.5 text-xs font-semibold text-white">Overdue</span>
                      <% end %>
                      <% if item.completed_at.present? %>
                        <span aria-hidden="true">·</span>
                        <span>completed <%= item.completed_at.to_date %></span>
                      <% elsif item.cancelled_at.present? %>
                        <span aria-hidden="true">·</span>
                        <span>cancelled <%= item.cancelled_at.to_date %></span>
                      <% end %>
                    </p>
                    <%= render "action_items/activity", item: item, branded: true %>
                  </div>
                  <% if item.available_statuses(for_owner: true).any? %>
                    <%= render "action_items/status_form",
                               item: item,
                               url: participant_action_item_path(item),
                               branded: true,
                               for_owner: true %>
                  <% end %>
                </div>
              </article>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="home-card px-6 py-5">
          <p class="font-semibold text-ink">No action items</p>
          <p class="mt-2 leading-6 text-[#466057]">You're all caught up. New commitments assigned to you will appear here.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
