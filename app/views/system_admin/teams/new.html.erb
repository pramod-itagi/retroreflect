<p class="mb-2 text-sm text-slate-500"><%= back_link system_admin_teams_path, "teams" %></p>
<h1 class="mb-6 text-2xl font-semibold">Create Team</h1>

<%= form_with model: @team, url: system_admin_teams_path, class: "max-w-md space-y-4" do |form| %>
  <% if @team.errors.any? %>
    <ul class="list-disc rounded border border-red-200 bg-red-50 px-5 py-3 text-sm text-red-800">
      <% @team.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
  <div>
    <%= form.label :name, "Team name", class: "mb-1 block text-sm font-medium" %>
    <%= form.text_field :name, required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
  </div>
  <div>
    <%= label_tag :facilitator_id, "Initial Facilitator", class: "mb-1 block text-sm font-medium" %>
    <%= select_tag :facilitator_id,
                   options_from_collection_for_select(@candidate_users, :id, :display_name, params[:facilitator_id]),
                   prompt: "Select a confirmed user",
                   class: "h-10 w-full rounded border border-slate-300 py-2 pl-3 pr-10 text-sm" %>
  </div>
  <div class="flex flex-wrap gap-3">
    <%= link_to "Cancel", system_admin_teams_path, class: "rounded border border-slate-300 bg-white px-3 py-2 text-sm" %>
    <%= form.submit "Create Team", class: "rounded bg-teal-700 px-4 py-2 text-sm text-white hover:bg-teal-800" %>
  </div>
<% end %>
