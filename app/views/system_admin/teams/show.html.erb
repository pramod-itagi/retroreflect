<% content_for :full_bleed, true %>

<div class="workspace-page workspace-shell listing-page admin-page">
  <div class="listing-inner">
    <header class="listing-intro">
      <p class="listing-back">
        <%= back_nav_link system_admin_teams_path, "teams" %>
      </p>
      <p class="listing-kicker">Administration</p>
      <h1 class="display-face listing-heading break-words"><%= @team.name %></h1>
      <% if @team.archived? %>
        <p class="listing-lede">This team is archived.</p>
      <% end %>
    </header>

    <div class="listing-stack">
      <section>
        <div class="home-card admin-team-panel">
          <h2 class="display-face home-section-title">Members (<%= @memberships.size %>)</h2>
          <% if @memberships.any? %>
            <ul class="admin-team-member-list mt-5">
              <% @memberships.each do |membership| %>
                <li class="admin-team-member">
                  <div class="flex min-w-0 items-center gap-3">
                    <span class="member-avatar <%= membership.facilitator? ? "member-avatar-facilitator" : "" %>" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21a8 8 0 0 0-16 0"/>
                        <circle cx="12" cy="8" r="3.25"/>
                      </svg>
                    </span>
                    <div class="min-w-0">
                      <p class="member-row-name"><%= display_name_for(membership.user) %></p>
                      <p class="admin-team-member-role"><%= membership.role.humanize %></p>
                    </div>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <div class="mt-5">
              <p class="font-semibold text-ink">No current members</p>
              <p class="mt-2 leading-6 text-muted">There are no current members to display yet.</p>
            </div>
          <% end %>
        </div>
      </section>

      <% if @team.active? %>
        <section class="mt-10 lg:mt-12">
          <div class="home-card admin-team-panel">
            <h2 class="display-face home-section-title">Archive team</h2>
            <p class="mt-3 max-w-2xl leading-6 text-muted">
              Archiving removes all current members from this team and prevents new retrospectives. Historical retrospectives and action items are retained.
            </p>
            <div class="mt-5">
              <%= link_to "Archive team", new_system_admin_team_archive_path(@team), class: "home-action home-action-danger-solid" %>
            </div>
          </div>
        </section>
      <% end %>
    </div>
  </div>
</div>
