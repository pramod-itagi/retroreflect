<% content_for :full_bleed, true %>

<div class="login-page auth-screen workspace-shell">
  <section class="auth-split">
    <div class="auth-copy">
      <%= render "shared/auth_copy",
                 heading: "Choose a new password",
                 lede: "Create a strong password to keep your account secure.",
                 show_back: true %>
    </div>

    <div class="auth-panel">
      <div class="login-form-card">
        <%= form_with model: @user, url: password_reset_path(token: params[:token]), method: :patch, class: "auth-form" do |form| %>
          <% if @user.errors.any? %>
            <%= app_alert(kind: "error", messages: @user.errors.full_messages, autohide: false) %>
          <% end %>

          <div>
            <%= form.label :password, class: "auth-field-label" %>
            <div class="action-item-control action-item-control--text">
              <%= render "shared/auth_field_icon", name: "lock" %>
              <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Enter your new password", class: "workspace-field", aria: { describedby: "password-reset-hint" } %>
            </div>
            <p id="password-reset-hint" class="mt-2 text-sm leading-6 text-muted">Use at least 8 characters with a mix of letters, numbers and symbols.</p>
          </div>
          <div>
            <%= form.label :password_confirmation, class: "auth-field-label" %>
            <div class="action-item-control action-item-control--text">
              <%= render "shared/auth_field_icon", name: "lock" %>
              <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Confirm your new password", class: "workspace-field" %>
            </div>
          </div>
          <%= form.submit "Update password", class: "home-action home-action-primary" %>
        <% end %>
      </div>
    </div>
  </section>
</div>
