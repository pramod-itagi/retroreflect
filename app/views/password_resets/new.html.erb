<% content_for :full_bleed, true %>

<div class="login-page auth-screen workspace-shell">
  <section class="auth-split">
    <div class="auth-copy">
      <%= render "shared/auth_copy",
                 heading: "Forgot password",
                 lede: "Enter your email and we'll send you instructions to reset your password." %>
    </div>

    <div class="auth-panel">
      <div class="login-form-card">
        <%= form_with url: password_resets_path, class: "auth-form" do %>
          <div>
            <%= label_tag :email, "Email", class: "auth-field-label" %>
            <div class="action-item-control action-item-control--text">
              <%= render "shared/auth_field_icon", name: "email" %>
              <%= email_field_tag :email, nil, required: true, autocomplete: "email", placeholder: "you@example.com", class: "workspace-field" %>
            </div>
          </div>
          <%= submit_tag "Send reset instructions", class: "home-action home-action-primary" %>
        <% end %>

        <p class="auth-back">
          <%= back_nav_link new_session_path, "sign in" %>
        </p>
      </div>
    </div>
  </section>
</div>
