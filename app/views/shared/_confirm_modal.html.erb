<div class="app-confirm"
     data-controller="confirm"
     aria-hidden="true">
  <div class="app-confirm-backdrop" data-action="click->confirm#cancel"></div>
  <div class="app-confirm-dialog"
       role="dialog"
       aria-modal="true"
       aria-labelledby="app-confirm-title"
       data-confirm-target="dialog">
    <h2 id="app-confirm-title" class="app-confirm-title" data-confirm-target="message"></h2>
    <p id="app-confirm-description"
       class="app-confirm-copy"
       data-confirm-target="description"
       hidden></p>
    <div class="app-confirm-actions">
      <button type="button"
              class="home-action home-action-secondary"
              data-confirm-target="cancel"
              data-action="confirm#cancel">
        Cancel
      </button>
      <button type="button"
              class="home-action home-action-primary"
              data-confirm-target="accept"
              data-action="confirm#confirm">
        Continue
      </button>
    </div>
  </div>
</div>
