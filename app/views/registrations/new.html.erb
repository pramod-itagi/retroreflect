<% content_for :full_bleed, true %>

<div class="register-page auth-screen workspace-shell">
  <section class="auth-split">
    <div class="auth-copy">
      <%= render "shared/auth_copy",
                 heading: "Create your account",
                 lede: "Create an account and start reflecting with your team." %>
    </div>

    <div class="auth-panel">
      <div class="login-form-card">
        <%= form_with model: @user, url: registrations_path, class: "auth-form" do |form| %>
          <% if @user.errors.any? %>
            <%= app_alert(kind: "error", messages: @user.errors.full_messages, autohide: false) %>
          <% end %>

          <div>
            <%= form.label :name, class: "auth-field-label" %>
            <div class="action-item-control action-item-control--text">
              <%= render "shared/auth_field_icon", name: "person" %>
              <%= form.text_field :name, required: true, autocomplete: "name", placeholder: "Your name", class: "workspace-field" %>
            </div>
          </div>
          <div>
            <%= form.label :email, class: "auth-field-label" %>
            <div class="action-item-control action-item-control--text">
              <%= render "shared/auth_field_icon", name: "email" %>
              <%= form.email_field :email, required: true, autocomplete: "email", placeholder: "you@example.com", class: "workspace-field" %>
            </div>
          </div>
          <div>
            <%= form.label :password, class: "auth-field-label" %>
            <div class="action-item-control action-item-control--text">
              <%= render "shared/auth_field_icon", name: "lock" %>
              <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Enter your password", class: "workspace-field" %>
            </div>
          </div>
          <div>
            <%= form.label :password_confirmation, class: "auth-field-label" %>
            <div class="action-item-control action-item-control--text">
              <%= render "shared/auth_field_icon", name: "lock" %>
              <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Confirm your password", class: "workspace-field" %>
            </div>
          </div>
          <%= form.submit "Register", class: "home-action home-action-primary" %>
        <% end %>

        <p class="auth-back">
          <%= back_nav_link new_session_path, "sign in" %>
        </p>
      </div>
    </div>
  </section>
</div>
