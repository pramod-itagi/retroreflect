<% content_for :full_bleed, true %>

<div class="register-page auth-screen workspace-shell">
  <section class="auth-split">
    <div class="auth-copy">
      <div class="auth-copy-inner">
        <p class="auth-kicker">
          <span class="auth-kicker-dot" aria-hidden="true"></span>
          Retroreflect
        </p>
        <h1 class="display-face auth-heading">Create your account</h1>
        <p class="auth-lede">Create an account and start reflecting with your team.</p>
      </div>
    </div>

    <div class="auth-panel">
      <div class="login-form-card">
        <%= form_with model: @user, url: registrations_path, class: "space-y-4" do |form| %>
          <% if @user.errors.any? %>
            <%= app_alert(kind: "error", messages: @user.errors.full_messages, autohide: false) %>
          <% end %>

          <div>
            <%= form.label :name, class: "mb-2 block text-sm font-semibold text-ink" %>
            <%= form.text_field :name, required: true, autocomplete: "name", class: "login-field" %>
          </div>
          <div>
            <%= form.label :email, class: "mb-2 block text-sm font-semibold text-ink" %>
            <%= form.email_field :email, required: true, autocomplete: "email", class: "login-field" %>
          </div>
          <div>
            <%= form.label :password, class: "mb-2 block text-sm font-semibold text-ink" %>
            <%= form.password_field :password, required: true, autocomplete: "new-password", class: "login-field" %>
          </div>
          <div>
            <%= form.label :password_confirmation, class: "mb-2 block text-sm font-semibold text-ink" %>
            <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "login-field" %>
          </div>
          <%= form.submit "Register", class: "home-action home-action-primary mt-1" %>
        <% end %>

        <p class="mt-6 text-sm">
          <%= back_nav_link new_session_path, "sign in" %>
        </p>
      </div>
    </div>
  </section>
</div>
